<Project Sdk="Microsoft.NET.Sdk">
 <PropertyGroup>
  <OutputType>WinExe</OutputType><TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
  <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion><RootNamespace>FluentTlsTunnel</RootNamespace>
  <AssemblyName>FluentTlsTunnel</AssemblyName><ApplicationManifest>app.manifest</ApplicationManifest><ApplicationIcon>1-AppIcon.ico</ApplicationIcon>
  <Platforms>x64</Platforms><PlatformTarget>x64</PlatformTarget><RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
  <UseWinUI>true</UseWinUI><EnableMsixTooling>true</EnableMsixTooling><WindowsPackageType>None</WindowsPackageType>
  <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained><SelfContained>true</SelfContained>
  <Nullable>enable</Nullable><ImplicitUsings>enable</ImplicitUsings><Version>0.2.1</Version>
  <Product>Fluent TLS Tunnel</Product><Authors>Mohamed Elnaggar</Authors>
 </PropertyGroup>
 <ItemGroup><Compile Remove="Core/**/*.cs;Tests/**/*.cs;TunnelCore.cs;CoreTests.cs;RoutingTests.cs;ConfigCrypto.cs;PasswordStoreTests.cs;SecurePasswordFile.cs" /><Page Remove="Tests/**/*.xaml" /></ItemGroup>
 <ItemGroup><ProjectReference Include="TunnelCore.csproj" /><PackageReference Include="Microsoft.WindowsAppSDK" Version="1.6.250108002" /></ItemGroup>
 <ItemGroup><Content Include="Routing/**/*;RoutingHelper.ps1;RouteDiscovery.ps1" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" /></ItemGroup>
 <ItemGroup><Content Include="3-AppIcon.png" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" /><Content Include="1-AppIcon.ico" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" /></ItemGroup>
</Project>
