<Window x:Class="FluentTlsTunnel.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Fluent TLS Tunnel">
 <Grid x:Name="Root">
  <Grid.RowDefinitions><RowDefinition Height="48"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <Grid Canvas.ZIndex="1"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Grid x:Name="AppTitleBar" Background="Transparent"><StackPanel Orientation="Horizontal" Spacing="8" Margin="14,0,14,0" VerticalAlignment="Center"><Image Source="ms-appx:///3-AppIcon.png" Width="20" Height="20"/><TextBlock Text="Fluent TLS Tunnel" FontSize="12" VerticalAlignment="Center"/></StackPanel></Grid><StackPanel Grid.Column="1" Orientation="Horizontal"><Button x:Name="MinimizeCaption" Width="46" Height="48" CornerRadius="0" Background="Transparent" BorderThickness="0" Click="MinimizeCaptionClick" AutomationProperties.Name="Minimize"><FontIcon Glyph="&#xE921;" FontSize="10"/></Button><Button x:Name="MaximizeCaption" Width="46" Height="48" CornerRadius="0" Background="Transparent" BorderThickness="0" Click="MaximizeCaptionClick" AutomationProperties.Name="Maximize or restore"><FontIcon x:Name="MaximizeCaptionGlyph" Glyph="&#xE922;" FontSize="10"/></Button><Button x:Name="CloseCaption" Width="46" Height="48" CornerRadius="0" Background="Transparent" BorderThickness="0" Click="CloseCaptionClick" AutomationProperties.Name="Close"><FontIcon Glyph="&#xE8BB;" FontSize="10"/></Button></StackPanel></Grid>
  <NavigationView x:Name="Nav" Grid.Row="1" PaneDisplayMode="Left" IsSettingsVisible="False" IsPaneOpen="True" OpenPaneLength="220" IsBackButtonVisible="Collapsed" SelectionChanged="NavChanged">
<NavigationView.MenuItems><NavigationViewItem x:Name="ConnectionNav" Tag="connection" Content="Connection"><NavigationViewItem.Icon><SymbolIcon Symbol="Link"/></NavigationViewItem.Icon></NavigationViewItem></NavigationView.MenuItems><NavigationView.FooterMenuItems><NavigationViewItem x:Name="SettingsNav" Tag="settings" Content="Settings"><NavigationViewItem.Icon><SymbolIcon Symbol="Setting"/></NavigationViewItem.Icon></NavigationViewItem><NavigationViewItem x:Name="AboutNav" Tag="about" Content="About"><NavigationViewItem.Icon><SymbolIcon Symbol="Help"/></NavigationViewItem.Icon></NavigationViewItem></NavigationView.FooterMenuItems><Border Margin="0,0,16,16" CornerRadius="8" Background="{ThemeResource LayerFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"><Grid Padding="28,24"><ScrollViewer x:Name="ConnectionPage" HorizontalScrollBarVisibility="Disabled"><StackPanel Spacing="16" MaxWidth="920" HorizontalAlignment="Stretch">
   <TextBlock x:Name="Subtitle" FontSize="28" FontWeight="SemiBold" Margin="0,0,0,4"/>
   <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="16,12"><Grid ColumnSpacing="16" MinHeight="48"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><FontIcon x:Name="StatusGlyph" Glyph="&#xE72E;" FontSize="20" VerticalAlignment="Center"/><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock x:Name="HeroTitle" Style="{StaticResource BodyStrongTextBlockStyle}"/><TextBlock x:Name="HeroDetail" TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel><TextBlock x:Name="ConnectionTime" Grid.Column="2" Text="00:00:00" Visibility="Collapsed" VerticalAlignment="Center" FlowDirection="LeftToRight" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></Grid></Border>
   <InfoBar x:Name="Status" IsOpen="False" IsClosable="False" Severity="Informational"/>
   <StackPanel x:Name="ProfilePanel" Spacing="8"><TextBlock x:Name="ProfileGroup" FontSize="13" FontWeight="SemiBold" Margin="0,8,0,0"/>
   <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
    <StackPanel Spacing="14">
     <StackPanel Orientation="Horizontal" Spacing="8"><Button x:Name="Import" Click="ImportClick"/><Button x:Name="Export" Click="ExportClick"/></StackPanel>
     <TextBlock x:Name="ConnectionTitle" FontSize="18" FontWeight="SemiBold"/>
     <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="120"/></Grid.ColumnDefinitions><TextBox x:Name="Host" FlowDirection="LeftToRight"/><NumberBox x:Name="Port" Grid.Column="1" Minimum="1" Maximum="65535" SpinButtonPlacementMode="Compact" FlowDirection="LeftToRight"/></Grid>
     <TextBox x:Name="Sni" FlowDirection="LeftToRight"/>
     <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBox x:Name="Username" FlowDirection="LeftToRight"/><PasswordBox x:Name="Password" Grid.Column="1" FlowDirection="LeftToRight"/></Grid>
     <CheckBox x:Name="VerifyTls" IsChecked="False"/>
     <TextBlock x:Name="TlsHint" TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
    </StackPanel>
   </Border>
   </StackPanel>

  <Grid x:Name="ConnectionActions" ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Button x:Name="ConnectButton" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Left" MinWidth="130" Click="ConnectClick"><StackPanel Orientation="Horizontal" Spacing="8"><SymbolIcon x:Name="ConnectIcon" Symbol="Link"/><TextBlock x:Name="ConnectLabel" VerticalAlignment="Center"/></StackPanel></Button><Button x:Name="Save" Grid.Column="1" Click="SaveClick"/></Grid>
   <Expander x:Name="LogsPanel" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"><StackPanel Spacing="8"><Button x:Name="ClearLog" Click="ClearLogClick" HorizontalAlignment="Right"/><TextBox x:Name="Logs" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" Height="420" MinWidth="560" HorizontalAlignment="Stretch" ScrollViewer.VerticalScrollBarVisibility="Auto" FlowDirection="LeftToRight" FontFamily="Cascadia Mono"/></StackPanel></Expander>

  </StackPanel></ScrollViewer><ScrollViewer x:Name="SettingsPage" Visibility="Collapsed" HorizontalScrollBarVisibility="Disabled"><StackPanel Spacing="12" MaxWidth="640" HorizontalAlignment="Stretch"><TextBlock x:Name="SettingsTitle" FontSize="28" FontWeight="SemiBold" Margin="0,0,0,12"/><TextBlock x:Name="AppearanceGroup" FontSize="13" FontWeight="SemiBold"/><Border CornerRadius="8" Padding="16" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"><StackPanel Orientation="Horizontal" Spacing="8"><ComboBox x:Name="Language" Width="130" SelectionChanged="SettingsChanged"><ComboBoxItem Content="System" Tag="system"/><ComboBoxItem Content="English" Tag="en"/><ComboBoxItem Content="العربية" Tag="ar"/></ComboBox><ComboBox x:Name="Theme" Width="110" SelectionChanged="SettingsChanged"><ComboBoxItem Content="System" Tag="system"/><ComboBoxItem Content="Light" Tag="light"/><ComboBoxItem Content="Dark" Tag="dark"/></ComboBox></StackPanel>
</Border><Border CornerRadius="8" Padding="16" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"><StackPanel Spacing="8"><TextBlock x:Name="BackdropHeading" FontWeight="SemiBold"/><StackPanel Orientation="Horizontal" Spacing="16"><RadioButton x:Name="AcrylicOption" Content="Acrylic" Tag="acrylic" GroupName="Backdrop" Checked="BackdropChanged"/><RadioButton x:Name="MicaOption" Content="Mica" Tag="mica" GroupName="Backdrop" Checked="BackdropChanged"/><RadioButton x:Name="MicaAltOption" Content="Mica Alt" Tag="mica-alt" GroupName="Backdrop" Checked="BackdropChanged"/></StackPanel></StackPanel></Border><TextBlock x:Name="RoutingGroup" FontSize="13" FontWeight="SemiBold" Margin="0,12,0,0"/>   <StackPanel x:Name="AdvancedPanel" Spacing="12">
   <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
    <StackPanel Spacing="12">
     <TextBlock x:Name="RoutingTitle" FontSize="18" FontWeight="SemiBold" Visibility="Collapsed"/><CheckBox x:Name="RouteWindows" IsChecked="True"/>
     <NumberBox x:Name="SocksPort" Minimum="1024" Maximum="65535" Value="1080" SpinButtonPlacementMode="Compact" FlowDirection="LeftToRight"/>
     <TextBlock x:Name="ProxyHint" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
     <CheckBox x:Name="UseDns"/>
     <ComboBox x:Name="Adapter" HorizontalAlignment="Stretch"/>
     <TextBox x:Name="Dns" PlaceholderText="1.1.1.1" FlowDirection="LeftToRight"/><TextBox x:Name="DnsSecondary" PlaceholderText="1.0.0.1" FlowDirection="LeftToRight"/>
     <TextBlock x:Name="DnsHint" TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
     <Button x:Name="RestoreRouting" Click="RestoreRoutingClick"/><Button x:Name="RestoreDns" Click="RestoreDnsClick"/>
    </StackPanel>
   </Border>
   </StackPanel>
<Border CornerRadius="12" Padding="24" BorderThickness="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"><StackPanel Spacing="8"><TextBlock x:Name="UpdatesHeadingSettings" FontSize="16" FontWeight="SemiBold"/><TextBlock x:Name="UpdatesNoteSettings" FontSize="13" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/><TextBlock x:Name="InstalledVersionSettings" FontSize="13"/><Button x:Name="CheckUpdatesSettings" Click="CheckUpdatesClick" HorizontalAlignment="Left"/><TextBlock x:Name="UpdateResultSettings" FontSize="13" TextWrapping="Wrap"/><HyperlinkButton x:Name="UpdateLinkSettings" Visibility="Collapsed" HorizontalAlignment="Left"/></StackPanel></Border></StackPanel></ScrollViewer><ScrollViewer x:Name="AboutPanel" Visibility="Collapsed" HorizontalScrollBarVisibility="Disabled"><StackPanel Spacing="14" Padding="16" HorizontalAlignment="Center" MaxWidth="520">

<Image Source="ms-appx:///3-AppIcon.png" Width="128" Height="128"/>
<TextBlock Text="Fluent TLS Tunnel" FontSize="26" FontWeight="SemiBold" HorizontalAlignment="Center"/>
<TextBlock x:Name="VersionText" HorizontalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
<TextBlock x:Name="AboutDescription" TextWrapping="Wrap" TextAlignment="Center"/>
<Border CornerRadius="8" Padding="16" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"><StackPanel Spacing="8">
<TextBlock x:Name="DeveloperCredit" HorizontalAlignment="Center" FontWeight="SemiBold"/>
<HyperlinkButton Content="brought to you by Instinct" NavigateUri="https://instinct.com" HorizontalAlignment="Center" FlowDirection="LeftToRight"/>
<HyperlinkButton x:Name="RepositoryLink" NavigateUri="https://github.com/MohamedElnaggar00/fluent-tls-tunnel" HorizontalAlignment="Center" FlowDirection="LeftToRight"/>
<TextBlock Text="MIT License" HorizontalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
</StackPanel></Border><Border CornerRadius="12" Padding="24" BorderThickness="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"><StackPanel Spacing="8"><TextBlock x:Name="UpdatesHeadingAbout" FontSize="16" FontWeight="SemiBold"/><TextBlock x:Name="UpdatesNoteAbout" FontSize="13" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/><TextBlock x:Name="InstalledVersionAbout" FontSize="13"/><Button x:Name="CheckUpdatesAbout" Click="CheckUpdatesClick" HorizontalAlignment="Left"/><TextBlock x:Name="UpdateResultAbout" FontSize="13" TextWrapping="Wrap"/><HyperlinkButton x:Name="UpdateLinkAbout" Visibility="Collapsed" HorizontalAlignment="Left"/></StackPanel></Border></StackPanel></ScrollViewer></Grid></Border></NavigationView>

 </Grid>
</Window>
